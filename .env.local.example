# Frontend environment — copy to .env.local for local development.
# On Vercel, set the same keys under Settings → Environment Variables.
#
# Vite only exposes VITE_* variables to the browser, and it bakes them in at
# BUILD time — changing one on Vercel needs a redeploy to take effect.

# URL of the backend API.
# Local development (cd backend && npm run dev):
VITE_API_URL=http://localhost:3001
# Production:
# VITE_API_URL=https://orchestra-core.onrender.com

# The price shown on the site, in KES.
# Must match PRICE_KES on the backend, which is what actually gets charged.
VITE_PRICE_KES=200
