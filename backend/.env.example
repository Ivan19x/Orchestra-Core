# ============================================================================
# Orchestra-Core API — environment variables
# Copy to backend/.env for local dev; set the same keys in your host's
# dashboard (Render → Environment) for production. NEVER commit the real .env.
# ============================================================================

PORT=3001
NODE_ENV=development

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_random_bytes_hex

# ── Database (Supabase) ─────────────────────────────────────────────────────
# supabase.com → your project → Settings → API
# SUPABASE_SERVICE_KEY is the service_role key. It bypasses row-level security:
# server-side only, never put it in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── M-Pesa (Safaricom Daraja) ───────────────────────────────────────────────
# developer.safaricom.co.ke → My Apps → your app
MPESA_ENV=sandbox                      # 'sandbox' while testing, 'production' when live
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret

# The shortcode the passkey belongs to.
#   Sandbox: 174379 (Safaricom's test paybill)
#   Production: your own Paybill, or the Store/Head-Office number for a Till
MPESA_SHORTCODE=174379

# Lipa na M-Pesa Online passkey.
# Sandbox value (public, from Safaricom's own docs):
#   bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_PASSKEY=your-lipa-na-mpesa-passkey

# Paybill  -> CustomerPayBillOnline  (leave PARTY_B unset)
# Till/Buy Goods -> CustomerBuyGoodsOnline, and set MPESA_PARTY_B to the Till number
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# MPESA_PARTY_B=

# Where Safaricom POSTs the payment result. Must be a PUBLIC https URL — it
# cannot be localhost. The secret at the end is your own random string and must
# match MPESA_CALLBACK_SECRET below (Daraja does not sign its callbacks, so an
# unguessable URL is what keeps strangers from forging one).
# Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=replace_with_a_long_random_string
MPESA_CALLBACK_URL=https://your-api-host.onrender.com/api/payment/callback/replace_with_a_long_random_string

# ── Pricing ─────────────────────────────────────────────────────────────────
# What we actually charge, in KES. Keep VITE_PRICE_KES on Vercel in sync so the
# displayed price matches. Set both to 1 for a real cheap end-to-end live test.
PRICE_KES=200

# ── Email ───────────────────────────────────────────────────────────────────
# Preferred: Gmail SMTP with an app password (free, delivers to anyone).
# Needs 2-Step Verification on the account, then: myaccount.google.com →
# Security → App passwords. Paste the 16 characters with no spaces.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Fallback, only used when GMAIL_* above are unset. Note that Resend's shared
# onboarding@resend.dev sender can ONLY email your own Resend account address
# until you verify a custom domain.
RESEND_API_KEY=
EMAIL_FROM=Orchestra-Core <onboarding@resend.dev>

# Where consultant applications and contact-form messages are sent.
# Falls back to GMAIL_USER if unset.
ADMIN_EMAIL=chweyaivan@gmail.com

# ── URLs ────────────────────────────────────────────────────────────────────
# Used in password-reset and purchase-confirmation email links.
FRONTEND_URL=http://localhost:8080

# Comma-separated list of browser origins allowed to call this API.
# Must include your live site, or the deployed website's requests get blocked.
CORS_ORIGINS=http://localhost:8080,https://orchestra-core.vercel.app
